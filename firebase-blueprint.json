        "createdAt": { "type": "string" }
      }
    },
    "bills": {
      "path": "users/{userId}/bills/{billId}",
      "schema": {
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "dueDate": { "type": "string" },
        "accountId": { "type": "string", "optional": true },
        "category": { "type": "string" },
        "recurrence": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
