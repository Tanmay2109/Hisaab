        "splits": { "type": "array" },
        "notes": { "type": "string", "optional": true },
        "receiptUrl": { "type": "string", "optional": true },
        "createdAt": { "type": "string" }
      }
    },
    "groupSettlements": {
      "path": "groups/{groupId}/settlements/{settlementId}",
      "schema": {
        "payerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string", "optional": true },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "groupActivities": {
      "path": "groups/{groupId}/activities/{activityId}",
      "schema": {
        "type": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "notifications": {
      "path": "notifications/{notificationId}",
      "schema": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      }
    },
    "auditLogs": {
      "path": "auditLogs/{logId}",
      "schema": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
